{
    "name":"Semaphore",
    "type":"HTTP",
    "path":"Software",
    "version":"1.0.0",
    "description":"An HTTP client for Semaphore, an Ansible front-end",
    "url":"",
    "downloadURL":"",
    "hasInput":true,
    "hasOutput":true,
    "hideDefaultCommands":true,
    "hideDefaultParameters":[
    ],
    "defaults":{
        "baseAddress":"http://127.0.0.1:3000/api"
    },
    "parameters":{
        "Token":{
            "type":"String"
        }
    },
    "values":{
        "Task status":{
            "type":"Container",
            "Id":{
                "type":"Integer",
                "readOnly":true
            },
            "Status":{
                "type":"Enum",
                "options":{
                    "success":"success",
                    "stopped":"stopped",
                    "failed":"failed"
                },
                "readOnly":true
            },
            "Template":{
                "type":"Integer",
                "readOnly":true
            }
        }
    },
    "scripts":[
        "Semaphore.js"
    ],
    "commands":{
        "Start":{
            "menu":"Tasks",  
            "callback":"startTask",
            "parameters":{
                "Project Id":{
                    "type":"Integer",
                    "default":0,
                    "description": "The Id of the project to send the request to"
                },
                "Template Id":{
                    "type":"Integer",
                    "default":0,
                    "description": "The Id of the template to start"
                },
                "Limit":{
                    "type":"String",
                    "description": "The limit parameter passed to the playbook execution (--limit)"
                }
            }
        },
        "Get":{
            "menu":"Tasks",  
            "callback":"getTask",
            "parameters":{
                "Project Id":{
                    "type":"Integer",
                    "default":0
                },
                "Task Id":{
                    "type":"Integer",
                    "default":0
                }
            }
        }
    }
}